Thumbs.db

# Paper drafts (not code)
AFCP_Credit_Scoring*.docx
AFCP_Credit_Scoring*.pdf

# Raw run logs
thesis_experiments/run_log_2023.txt

# Experiment results - keep only what actually backs the manuscript's tables
AFCP/experiments/results/

# Table 1 & 2 (SGC): summary CSV has Overall coverage, but not worst-group -
# keep the raw age25/agemedian seed files for that; pstatus isn't used in a table
thesis_experiments/results/south_german_credit/raw/*.txt
!thesis_experiments/results/south_german_credit/raw/sgc_age25_ndata500_lr0.0001_ttestdelta0.0_conditionalTrue_seed*.txt
!thesis_experiments/results/south_german_credit/raw/sgc_agemedian_ndata500_lr0.0001_ttestdelta0.0_conditionalTrue_seed*.txt
# pstatus: excluded from the manuscript (small groups, see 5.7) but kept for transparency
!thesis_experiments/results/south_german_credit/raw/sgc_pstatus_ndata500_lr0.0001_ttestdelta0.0_conditionalTrue_seed*.txt

# Table 3 (GMSC, age_3way): not in summary_by_attribute.csv at all -
# keep only the primary ndata12000 seed files, ignore the sample-size sweep variants
# and the single-attribute configs already captured in summary_by_attribute.csv.
# Also keep gmsc_multi_* (Section 4.2.3 exploratory multi-attribute analysis).
thesis_experiments/results/give_me_credit/raw/*.txt
!thesis_experiments/results/give_me_credit/raw/gmsc_age_3way_ndata12000_lr0.0001_ttestdelta0.0_conditionalTrue_seed*.txt
!thesis_experiments/results/give_me_credit/raw/gmsc_multi_ndata12000_lr0.0001_ttestdelta0.0_conditionalTrue_seed*.txt
# age+income two-attribute config, also discussed in Section 4.2.3
!thesis_experiments/results/give_me_credit/raw/gmsc_age_income_ndata12000_lr0.0001_ttestdelta0.0_conditionalTrue_seed*.txt
# ttest_delta = 0.05 runs (seed 2023): partial sensitivity analysis
!thesis_experiments/results/give_me_credit/raw/gmsc_age_3way_ndata*_lr0.0001_ttestdelta0.05_conditionalTrue_seed*.txt

# Table 4 (GMSC sample-size sweep): keep only the 5-seed combined summary,
# ignore the raw per-seed sweep files it's built from
thesis_experiments/results/give_me_credit/sample_size_sweep/raw/
